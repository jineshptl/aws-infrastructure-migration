global:
  scrape_interval: 15s

rule_files:
  - alerts.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: node
    static_configs:
{% for host in groups['all'] | sort %}
      - targets: ["{{ hostvars[host].private_ip_address }}:9100"]
        labels:
          instance: {{ host }}
{% endfor %}
